# Resend e-posta gönderimi (iletişim formu)
# Anahtarı https://resend.com/api-keys adresinden alın.
RESEND_API_KEY=

# Teklif taleplerinin gideceği e-posta
CONTACT_TO_EMAIL=info@pinoromork.com

# Gönderen adresi — domain Resend'de doğrulanmalı (ör. "Pino Römork <bilgi@pinoromork.com>").
# Doğrulama yapılana kadar test için: "Pino Römork <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=Pino Römork <onboarding@resend.dev>

# Sunucuda çalışacağı port (PM2/next start)
PORT=3411
